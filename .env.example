# Copy the values you need into Render's Environment tab (never commit real values).
APP_MODE=cloud
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
SECRET_KEY=generate-64-random-characters
PUBLIC_URL=https://your-app.onrender.com
ADMIN_EMAILS=you@gmail.com

# Google sign-in (Google Cloud console -> APIs & Services -> Credentials -> OAuth client ID, type Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email sign-in links (optional). Gmail: smtp.gmail.com, port 587, an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Internship Tracker <you@gmail.com>

# Optional: only these emails / domains may sign up (comma-separated). Empty = anyone.
ALLOWED_EMAILS=
ALLOWED_DOMAINS=

# Optional: lets admins press "Run bot now" (dispatches the GitHub Actions workflow).
GITHUB_REPO=your-github-user/internship-tracker
GITHUB_TOKEN=
GITHUB_WORKFLOW=daily-run.yml
GITHUB_REF=main

# Local testing only: log sign-in links to the console instead of emailing them.
# EMAIL_DEV_LOG=1
